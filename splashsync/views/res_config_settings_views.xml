<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.splashsync</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Splash Sync" string="Splash Sync" name="splashsync" groups="base.group_system">
                    <block title="Splash Server" name="splash_server">
                        <setting string="Server Identification" help="Credentials of this Odoo company on Splash" id="splash_credentials">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="splash_ws_id" class="col-lg-4 o_light_label"/>
                                    <field name="splash_ws_id"/>
                                </div>
                                <div class="row">
                                    <label for="splash_ws_key" class="col-lg-4 o_light_label"/>
                                    <field name="splash_ws_key" password="True"/>
                                </div>
                                <div class="row">
                                    <label for="splash_ws_user_id" class="col-lg-4 o_light_label"/>
                                    <field name="splash_ws_user_id"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Expert Mode" help="Use another Splash server" id="splash_expert">
                            <field name="splash_ws_expert"/>
                            <div class="content-group" invisible="not splash_ws_expert">
                                <div class="row mt8">
                                    <label for="splash_ws_host" class="col-lg-4 o_light_label"/>
                                    <field name="splash_ws_host"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Disable Commits" help="Do not notify Splash of changes made in Odoo" id="splash_no_commits">
                            <field name="splash_no_commits"/>
                        </setting>
                    </block>
                    <block title="Products" name="splash_products">
                        <setting string="Simplified Prices" id="splash_simplified_prices">
                            <field name="splash_product_simplified_prices"/>
                        </setting>
                        <setting string="Advanced Taxes" id="splash_product_taxes">
                            <field name="splash_product_advanced_taxes"/>
                        </setting>
                        <setting string="Advanced Variants" id="splash_variants">
                            <field name="splash_product_advanced_variants"/>
                        </setting>
                        <setting string="Detect Products by SKU" id="splash_sku">
                            <field name="splash_product_sku_detection"/>
                        </setting>
                    </block>
                    <block title="Sales" name="splash_sales">
                        <setting string="Default Sales Team" id="splash_team">
                            <field name="splash_sales_team_id"/>
                        </setting>
                        <setting string="Advanced Taxes" id="splash_sales_taxes">
                            <field name="splash_sales_advanced_taxes"/>
                        </setting>
                        <setting string="Self Invoiced Orders" id="splash_self_invoiced">
                            <field name="splash_sales_self_invoiced"/>
                        </setting>
                        <setting string="Check Payments Amounts" id="splash_payments">
                            <field name="splash_sales_check_payments"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
